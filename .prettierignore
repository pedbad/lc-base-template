# Files Prettier should never touch.
# (Prettier already skips node_modules by default; listed here for clarity.)

# Generated / build output
node_modules
dist
dist-ssr
coverage
playwright-report
test-results

# Lockfile — owned by Bun, not Prettier. Reformatting it would corrupt it.
bun.lock
bun.lockb

# Per-machine generated knowledge-graph / tool caches (never committed, never formatted).
graphify-out
.understand-anything
.impeccable

# CULP syllabi: read-only notes that must stay byte-identical to the files the
# maintainer supplied. Never formatted, never edited by hand. Its README is written in
# the repo, so it is formatted like any other doc.
docs/culp-syllabi/*
!docs/culp-syllabi/README.md
