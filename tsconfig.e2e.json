{
  /* The browser specs: tsconfig.node.json's options (strict included) plus DOM types,
     which only code inside page.evaluate() needs. Kept apart so vite.config.ts and the
     build plugins it imports stay Node-only (AGENTS.md hard constraints 1-2). */
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["e2e"]
}
